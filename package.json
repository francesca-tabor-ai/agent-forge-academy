{
  "name": "agent-forge-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run generate:city-banners",
    "build": "next build",
    "generate:city-banners": "tsx scripts/generate-city-banners.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:regression": "vitest run tests/regression",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:regression && npm run test:e2e",
    "sync-courses": "tsx scripts/sync-courses.ts",
    "sync-courses:dry-run": "tsx scripts/sync-courses.ts --dry-run",
    "generate-metadata": "tsx scripts/generate-metadata-files.ts",
    "lint:content": "tsx scripts/lint-content-guard.ts",
    "lint:all": "npm run lint && npm run lint:content",
    "validate:images": "tsx scripts/validate-course-images.ts",
    "validate:images:skip-external": "tsx scripts/validate-course-images.ts --skip-external",
    "validate:schema": "tsx scripts/validate-schema.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "@next/mdx": "^14.0.0",
    "@supabase/ssr": "^0.1.0",
    "@supabase/supabase-js": "^2.38.0",
    "@tanstack/react-query": "^5.17.0",
    "framer-motion": "^10.16.16",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.300.0",
    "mammoth": "^1.6.0",
    "next": "^14.0.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "server-only": "^0.0.1",
    "stripe": "^14.21.0",
    "swr": "^2.2.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^16.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.16"
  }
}
